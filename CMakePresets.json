{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "VEILDESK_AUTHENTICODE_PUBLISHER_SHA256": "$env{VEILDESK_AUTHENTICODE_PUBLISHER_SHA256}"
      }
    },
    {
      "name": "portable-core",
      "displayName": "Portable policy wire core (no platform runtime)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/portable-core",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "VEILDESK_BUILD_WINDOWS_APPS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    { "name": "portable-core", "configurePreset": "portable-core" }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "filter": { "exclude": { "label": "Interactive" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "portable-core",
      "configurePreset": "portable-core",
      "output": { "outputOnFailure": true }
    }
  ]
}
